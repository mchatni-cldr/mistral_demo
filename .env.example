# ---------------------------------------------------------------------------
# Impala / CDW connection  (read by iceberg_mcp/impala.py)
# ---------------------------------------------------------------------------

# Impala coordinator hostname. In CDW: Virtual Warehouse -> Copy Impala JDBC URL,
# take the host out of it. Do NOT include https:// or the port.
IMPALA_HOST=coordinator-<vw-name>.dw-<env>.<tenant>.cloudera.site
IMPALA_PORT=443

# CDP *workload* username and password (Management Console -> User Management ->
# your user -> Set Workload Password). NOT your SSO password.
IMPALA_USER=
IMPALA_PASSWORD=

# Database holding the Iceberg tables you want the demo to talk about.
IMPALA_DATABASE=default

# ---- Defaults below are correct for CDW over HTTPS; change only if you know why.
IMPALA_AUTH_MECHANISM=LDAP
IMPALA_HTTP_PATH=cliservice

# Parsed as real booleans ("1"/"true"/"yes"/"on" = on, anything else = off).
# Both must stay on for CDW over HTTPS.
IMPALA_USE_HTTP_TRANSPORT=true
IMPALA_USE_SSL=true

# ---------------------------------------------------------------------------
# MCP server (read by app.py)
# ---------------------------------------------------------------------------

# Leave both UNSET in Cloudera AI -- app.py reads $CDSW_APP_PORT automatically
# and binds 127.0.0.1, which is what the workbench ingress expects.
# For local testing: MCP_HOST=127.0.0.1 MCP_PORT=8000
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Path the MCP endpoint is served at. This is what you append to the app URL
# when registering the connector in Mistral.
MCP_PATH=/mcp

# Shared secret. UNSET (the default) = open endpoint, which is the point of a
# Cloudera AI app with "Enable Unauthenticated Access". Set it to any random
# string and paste the same value into the Mistral connector's bearer token to
# lock the endpoint down; nothing else needs to change.
# MCP_BEARER_TOKEN=
